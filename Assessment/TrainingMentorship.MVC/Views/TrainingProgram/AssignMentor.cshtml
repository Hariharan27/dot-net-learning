@model List<TrainingMentorship.Application.DTOs.Auth.UserDto>
@{
    ViewData["Title"] = "Assign Mentor";
    var programId = ViewBag.ProgramId;
}

<h2>Assign Mentor to Program</h2>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        No available mentors. All mentors are already assigned to this program.
    </div>

    <a asp-action="Details" asp-route-id="@programId" class="btn btn-secondary">
        Back to Program
    </a>
}
else
{
    <form method="post" asp-action="AssignMentorPost">
        <input type="hidden" name="ProgramId" value="@programId" />

        <div class="mb-3">
            <label class="form-label">Select Mentor</label>
            <select name="MentorId" class="form-select" required>
                <option value="">-- Select Mentor --</option>
                @foreach (var m in Model)
                {
                    <option value="@m.Id">@m.FullName (@m.Email)</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Assign</button>
        <a asp-action="Details" asp-route-id="@programId" class="btn btn-secondary ms-2">
            Cancel
        </a>
    </form>
}
