<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrainingMentorship</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    @{
        var isLoggedIn = Context.Session.GetString("JwtToken") != null;
        var role = Context.Session.GetString("UserRole");
        var fullName = Context.Session.GetString("FullName");
    }
    @if (isLoggedIn)
    {
        <!-- ===================== MAIN APP LAYOUT AFTER LOGIN ===================== -->
        <div class="d-flex">
            <!-- ========== SIDEBAR ========== -->
            <nav class="bg-dark text-white p-3" style="width: 250px; min-height: 100vh;">
                <h4 class="text-center mb-4">Training App</h4>

                <ul class="nav flex-column">


                    <!-- Admin ONLY Menu Items -->
                    @if (role == "Admin")
                    {
                        <li class="nav-item mb-2">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Register">
                                Register User
                            </a>
                        </li>
                    }

                    <li class="nav-item mb-2">
                        <a class="nav-link text-white" asp-controller="TrainingProgram" asp-action="Index">
                            Training Programs
                        </a>
                    </li>
                   
                    <li class="nav-item mt-4">
                        <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">
                            Logout
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- ========== MAIN CONTENT ========== -->
            <div class="flex-grow-1">

                <!-- TOP NAVBAR -->
                <nav class="navbar navbar-light bg-light border-bottom px-3">
                    <span class="navbar-text">
                        Logged in as <b>@fullName</b>
                    </span>
                </nav>

                <div class="container mt-4">
                    @RenderBody()
                </div>

            </div>
        </div>
    }
    else
    {
        <!-- ===================== LOGIN PAGE LAYOUT ===================== -->
        <div class="container mt-5">
            @RenderBody()
        </div>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
